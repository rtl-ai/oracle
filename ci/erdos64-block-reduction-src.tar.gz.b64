#!/usr/bin/env bash
# Execute and audit the rooted-block / 2-connected reduction in both directions.

set -Eeuo pipefail
umask 077
export LC_ALL=C
export PYTHONHASHSEED=0

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
PYTHON=${PYTHON:-python3}
OUT_DIR=${1:-"$ROOT_DIR/block-reduction-results"}
FORWARD_MAX_N=${FORWARD_MAX_N:-9}
REVERSE_MAX_N=${REVERSE_MAX_N:-8}
FORWARD_AUDIT_MAX_N=${FORWARD_AUDIT_MAX_N:-8}
SOURCE_REPOSITORY=${SOURCE_REPOSITORY:-UNVERIFIED}
SOURCE_COMMIT=${SOURCE_COMMIT:-UNVERIFIED}
STARTED_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
SECONDS=0

resolve_geng() {
  if [[ -n ${GENG_BIN:-} ]]; then
    command -v "$GENG_BIN"
  elif command -v geng >/dev/null 2>&1; then
    command -v geng
  elif command -v nauty-geng >/dev/null 2>&1; then
    command -v nauty-geng
  else
    return 1
  fi
}

GENG=$(resolve_geng) || {
  echo "run_block_reduction.sh: geng/nauty-geng not found" >&2
  exit 127
}

mkdir -p -- "$OUT_DIR"
LOG="$OUT_DIR/commands.log"
: > "$LOG"

run_logged() {
  local command=$1
  printf '$ %s\n' "$command" | tee -a "$LOG"
  set +e
  bash -o pipefail -c "$command" >> "$LOG" 2>&1
  local rc=$?
  set -e
  printf 'EXIT_CODE=%d\n' "$rc" | tee -a "$LOG"
  if (( rc != 0 )); then
    exit "$rc"
  fi
}

run_logged "git rev-parse HEAD"
run_logged "'$PYTHON' --version"
run_logged "'$GENG' -help 2>&1 | head -n 2"
run_logged "'$PYTHON' -m py_compile '$SCRIPT_DIR/block_graph.py' '$SCRIPT_DIR/cycle_oracles.py' '$SCRIPT_DIR/block_reduction.py' '$ROOT_DIR/tests/test_block_reduction.py'"
run_logged "cd '$ROOT_DIR' && '$PYTHON' -m unittest discover -s tests -p 'test_block_reduction.py' -v"

SOURCE_SHA=$(
  sha256sum "$SCRIPT_DIR/block_graph.py" "$SCRIPT_DIR/cycle_oracles.py" \
    "$SCRIPT_DIR/block_reduction.py" "$ROOT_DIR/tests/test_block_reduction.py" \
    "$SCRIPT_DIR/run_block_reduction.sh" | sha256sum | awk '{print $1}'
)
printf 'source_repository=%s\n' "$SOURCE_REPOSITORY" > "$OUT_DIR/RUN.txt"
printf 'source_commit=%s\n' "$SOURCE_COMMIT" >> "$OUT_DIR/RUN.txt"
printf 'source_bundle_sha256=%s\n' "$SOURCE_SHA" >> "$OUT_DIR/RUN.txt"
printf 'geng=%s\n' "$GENG" >> "$OUT_DIR/RUN.txt"
printf 'forward_max_n=%s\nreverse_max_n=%s\nforward_audit_max_n=%s\n' "$FORWARD_MAX_N" "$REVERSE_MAX_N" "$FORWARD_AUDIT_MAX_N" >> "$OUT_DIR/RUN.txt"
printf 'started_utc=%s\n' "$STARTED_UTC" >> "$OUT_DIR/RUN.txt"

mkdir -p "$OUT_DIR/forward" "$OUT_DIR/reverse"

for ((n = 4; n <= FORWARD_MAX_N; n++)); do
  dir="$OUT_DIR/forward/n$n"
  mkdir -p "$dir"
  run_logged "'$GENG' -c -q -d3 '$n' > '$dir/input.g6'"
  run_logged "wc -l '$dir/input.g6'"
  run_logged "sha256sum '$dir/input.g6'"
  audit=()
  if (( n <= FORWARD_AUDIT_MAX_N )); then
    audit=(--audit-powers)
  fi
  command=(
    "$PYTHON" "$SCRIPT_DIR/block_reduction.py" forward
    --certificates "$dir/certificates.jsonl"
    --summary "$dir/summary.json"
    "${audit[@]}"
  )
  printf '$' | tee -a "$LOG"
  printf ' %q' "${command[@]}" | tee -a "$LOG"
  printf " < %q > %q\n" "$dir/input.g6" "$dir/stdout.json" | tee -a "$LOG"
  set +e
  "${command[@]}" < "$dir/input.g6" > "$dir/stdout.json" 2> "$dir/stderr.log"
  rc=$?
  set -e
  printf 'EXIT_CODE=%d\n' "$rc" | tee -a "$LOG"
  (( rc == 0 )) || exit "$rc"
  run_logged "cat '$dir/summary.json'"
  run_logged "sha256sum '$dir/certificates.jsonl' '$dir/summary.json'"
  gzip -9 "$dir/input.g6" "$dir/certificates.jsonl"
done

for ((n = 3; n <= REVERSE_MAX_N; n++)); do
  dir="$OUT_DIR/reverse/n$n"
  mkdir -p "$dir"
  run_logged "'$GENG' -C -q -d2 '$n' > '$dir/input.g6'"
  run_logged "wc -l '$dir/input.g6'"
  run_logged "sha256sum '$dir/input.g6'"
  command=(
    "$PYTHON" "$SCRIPT_DIR/block_reduction.py" reverse
    --root-policy degree2-or-identity
    --skip-nonclass
    --audit-powers
    --certificates "$dir/certificates.jsonl"
    --summary "$dir/summary.json"
  )
  printf '$' | tee -a "$LOG"
  printf ' %q' "${command[@]}" | tee -a "$LOG"
  printf " < %q > %q\n" "$dir/input.g6" "$dir/stdout.json" | tee -a "$LOG"
  set +e
  "${command[@]}" < "$dir/input.g6" > "$dir/stdout.json" 2> "$dir/stderr.log"
  rc=$?
  set -e
  printf 'EXIT_CODE=%d\n' "$rc" | tee -a "$LOG"
  (( rc == 0 )) || exit "$rc"
  run_logged "cat '$dir/summary.json'"
  run_logged "sha256sum '$dir/certificates.jsonl' '$dir/summary.json'"
  gzip -9 "$dir/input.g6" "$dir/certificates.jsonl"
done

"$PYTHON" - "$OUT_DIR" <<'PY'
from __future__ import annotations
import json
from pathlib import Path
import sys

root = Path(sys.argv[1])
forward = [json.loads(path.read_text()) for path in sorted((root / "forward").glob("n*/summary.json"))]
reverse = [json.loads(path.read_text()) for path in sorted((root / "reverse").glob("n*/summary.json"))]
aggregate = {
    "forward_input_counts_by_order": {str(path.parent.name): entry["input_graphs"] for path, entry in zip(sorted((root / "forward").glob("n*/summary.json")), forward)},
    "forward_input_graphs": sum(entry["input_graphs"] for entry in forward),
    "forward_identity_biconnected": sum(entry["identity_biconnected"] for entry in forward),
    "forward_proper_end_blocks": sum(entry["proper_end_blocks"] for entry in forward),
    "forward_root_degree_2": sum(entry["root_degree_2"] for entry in forward),
    "forward_root_degree_at_least_3": sum(entry["root_degree_at_least_3"] for entry in forward),
    "reverse_input_graphs": sum(entry["input_graphs"] for entry in reverse),
    "reverse_admissible_rooted_blocks": sum(entry["admissible_rooted_blocks"] for entry in reverse),
    "reverse_identity_constructions": sum(entry["identity_constructions"] for entry in reverse),
    "reverse_glued_constructions": sum(entry["glued_constructions"] for entry in reverse),
    "all_commands_exit_zero": True,
}
(root / "aggregate.json").write_text(json.dumps(aggregate, indent=2, sort_keys=True) + "\n")
print(json.dumps(aggregate, indent=2, sort_keys=True))
PY

run_logged "cat '$OUT_DIR/aggregate.json'"
FINISHED_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
ELAPSED_SECONDS=$SECONDS
printf 'finished_utc=%s\nelapsed_seconds=%s\nstatus=complete\n' "$FINISHED_UTC" "$ELAPSED_SECONDS" >> "$OUT_DIR/RUN.txt"
(
  cd "$OUT_DIR"
  find . -type f ! -name SHA256SUMS.txt -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS.txt
)
